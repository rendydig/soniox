# Copy this file to .env and fill in your real keys.
# .env is gitignored and must not be committed.

SONIOX_API_KEY=your_soniox_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: path to a self-context file used by the AI worker
# SELF_CONTEXT_FILE=

# Optional: path to a Speaker-profile file. When unset/absent, the prompt tells
# the model the Speaker is unknown and to infer their role from the conversation.
# SPEAKER_CONTEXT_FILE=context_speaker.txt

# --- AI provider selection (translation, auto-reply, image reply) ---
# "gemini" (default) uses GEMINI_API_KEY above.
# "openai" targets any OpenAI-compatible endpoint (OpenRouter, x.ai, OpenAI, local).
AI_PROVIDER=gemini

# Model name. For gemini, falls back to GEMINI_MODEL then gemini-2.5-flash.
# AI_MODEL=gemini-2.5-flash

# Disable model "thinking"/reasoning tokens for faster replies (default: true).
# DISABLE_MODEL_REASONING=false

# --- Required only when AI_PROVIDER=openai ---
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=anthropic/claude-3.5-sonnet   # use a vision-capable model for screenshot replies

# --- JEV decision layer (optional, opt-in) ---
# JEV (typesafe/jev-1.13, via OpenRouter) runs a fast "System One" decision call
# before the reply: whether to reply, as whom, which speech act, and in what
# language. Off = today's plain auto-reply. JEV_API_KEY falls back to AI_API_KEY.
# JEV_BASE_URL has NO /v1 suffix (decisions live at {JEV_BASE_URL}/alpha/decisions).
# JEV_ENABLED=true
# JEV_API_KEY=sk-or-...
# JEV_BASE_URL=https://openrouter.ai/api
# JEV_MODEL=typesafe/jev-1.13
# JEV_MIN_CONFIDENCE=0.55
# JEV_SHOULD_REPLY_MIN=0.5

# Purposes: built-ins live in src/purposes.py; user edits and AI-learned
# purposes are merged from purposes.json (gitignored, generated locally).

# --- Bullet points (optional feature, off by default) ---
# The rolling bullet-point summary reuses the same provider/model selected above
# (no separate key). Tuning lives in src/config.py: BULLET_MAX_ITEMS,
# BULLET_FLUSH_INTERVAL_MS, BULLET_MAX_BUFFER_LINES, BULLET_PAUSED_BUFFER_MAX.
