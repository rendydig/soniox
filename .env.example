# Copy this file to .env and fill in your real keys.
# .env is gitignored and must not be committed.

SONIOX_API_KEY=your_soniox_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Host / Speaker context. These two variables are now only the *seed* for the
# first run plus the fallback used while the web service is unreachable: the
# live selection is owned by websocket-server/context-store.js and edited from
# the "Context" pane (Tool ▾), which stores it in context_state.json
# (gitignored). Each role's file may live anywhere — inside or outside the repo.
# A file that is missing is treated as "no context" (never an error), and the
# pane flags it so the path can be fixed.
# SELF_CONTEXT_FILE=
# SPEAKER_CONTEXT_FILE=

# --- AI provider selection (translation, auto-reply, image reply) ---
# "gemini" (default) uses GEMINI_API_KEY above.
# "openai" targets any OpenAI-compatible endpoint (OpenRouter, x.ai, OpenAI, local).
AI_PROVIDER=gemini

# Model name. For gemini, falls back to GEMINI_MODEL then gemini-2.5-flash.
# AI_MODEL=gemini-2.5-flash

# Disable model "thinking"/reasoning tokens for faster replies (default: true).
# DISABLE_MODEL_REASONING=false

# --- Required only when AI_PROVIDER=openai ---
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=anthropic/claude-3.5-sonnet   # use a vision-capable model for screenshot replies

# --- JEV decision layer (optional, opt-in) ---
# JEV (typesafe/jev-1.13, via OpenRouter) runs a fast "System One" decision call
# before the reply: whether to reply, as whom, which speech act, and in what
# language. Off = today's plain auto-reply. JEV_API_KEY falls back to AI_API_KEY.
# JEV_BASE_URL has NO /v1 suffix (decisions live at {JEV_BASE_URL}/alpha/decisions).
# JEV_ENABLED=true
# JEV_API_KEY=sk-or-...
# JEV_BASE_URL=https://openrouter.ai/api
# JEV_MODEL=typesafe/jev-1.13
# JEV_MIN_CONFIDENCE=0.55
# JEV_SHOULD_REPLY_MIN=0.5

# Purposes: built-ins live in src/purposes.py; user edits and AI-learned
# purposes are merged from purposes.json (gitignored, generated locally).

# --- Bullet points (optional feature, off by default) ---
# The rolling bullet-point summary reuses the same provider/model selected above
# (no separate key). Tuning lives in src/config.py: BULLET_MAX_ITEMS,
# BULLET_FLUSH_INTERVAL_MS, BULLET_MAX_BUFFER_LINES, BULLET_PAUSED_BUFFER_MAX.

# --- Session digest in the auto-reply prompt (opt-in) ---
# When on, the reply prompt also carries the session state the app already
# computed: the bullet list, the locked bullets, the extracted KYC speaker
# profile, the confirmed client brief and its own prior suggestions. Off (the
# default) leaves the prompt byte-identical to the pre-digest one. Truncation
# caps live in src/config.py (AUTO_REPLY_MAX_BULLETS / _BULLET_CHARS /
# _PROFILE_ITEMS / _BRIEF_CHARS / _PRIOR_SUGGESTIONS).
# AUTO_REPLY_CONTEXT_DIGEST=true

# --- Session objectives (the Bullet Points pane's Objectives tab) ---
# Automatic once objectives exist (no flag): the tracker predicts which session
# objective the conversation is working on, lockable per item, with a history
# timeline. Prediction is JEV-first with an LLM fallback, so it works without
# JEV too. Tuning lives in src/config.py: OBJECTIVE_DEBOUNCE_MS,
# OBJECTIVE_MIN_STREAK, OBJECTIVE_MAX_ITEMS, OBJECTIVE_MAX_HISTORY,
# OBJECTIVE_MAX_LINE_CHARS, OBJECTIVE_WINDOW_LINES.

# --- Logging / debug prompt dump ---
# LOG_LEVEL sets the root logger level (default: DEBUG). While it is DEBUG, every
# AI call also appends one block to logs/ai-prompt.log with the full system
# instruction, the messages, the call metadata (including the
# AUTO_REPLY_CONTEXT_DIGEST flag) and the model's reply. Set LOG_LEVEL=INFO to
# turn the dump off. It is gitignored and grows one block per AI call; images are
# counted, never dumped (they are base64 data URLs).
# LOG_LEVEL=DEBUG
